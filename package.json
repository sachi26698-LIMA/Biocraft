{
  "name": "biocraft",
  "private": true,
  "version": "1.0.0",
  "description": "BioCraft — All-in-One Social Media Toolkit for Instagram, Facebook, Threads, TikTok, X and LinkedIn: bios, usernames, stylish text, symbols, hashtags, captions and LinkedIn headline/summary generators. Free, private, rule-based. English & Hindi.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-shells.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed-supabase.mjs",
    "test:collections": "node tests/collection-navigation.cjs && node tests/remote-dedup.cjs && node tests/collection-pagination.cjs && node tests/collection-card-renders.cjs",
    "test:review": "esbuild review-harness.tsx --bundle --platform=node --format=cjs --loader:.css=empty --outfile=review-harness.bundle.cjs && node review-check.cjs",
    "test:diagnostics": "node tests/preview-diagnostics.cjs",
    "test:generation": "node tests/generation-runner.cjs && node tests/generation-steps.cjs && node tests/generation-ui.cjs",
    "test:performance": "node tests/symbol-search.cjs && node tests/symbol-renders.cjs && node tests/font-preloads.cjs",
    "test:admin-draft": "node tests/admin-draft-rbac.cjs && node tests/admin-workflow-draft.cjs && node tests/admin-gateway-draft.cjs",
    "test:admin-blueprint": "node tests/admin-blueprint-schema.cjs && node tests/admin-auth-blueprint.cjs",
    "test:admin-browser": "node tests/admin-preview-browser.cjs",
    "test:admin-catalog": "node tests/admin-catalog-audit.cjs",
    "test:admin-interactions": "node tests/admin-interaction-audit.cjs",
    "test:admin-public-regression": "node tests/admin-public-regression.cjs",
    "test:admin-performance": "node tests/admin-performance-audit.cjs",
    "test:admin-phase": "node tests/admin-phase-browser.cjs",
    "test:admin-lazy-error": "node tests/admin-lazy-error.cjs",
    "test:admin-phase3-schema": "node tests/admin-phase3-schema-review.cjs",
    "test:admin-privilege-review": "node tests/admin-privilege-review.cjs",
    "test:admin-isolated-foundation": "node tests/admin-isolated-foundation.cjs",
    "test:admin-isolated-workflow": "node tests/admin-isolated-workflow.cjs",
    "test:admin-isolated-permissions": "node tests/admin-isolated-permissions.cjs",
    "test:admin-bio-domain": "node tests/admin-bio-domain.mjs",
    "test:admin-identity": "node tests/admin-identity.mjs",
    "test:admin-private-commands": "node tests/admin-private-commands.cjs",
    "test:admin-auth-flow": "node tests/admin-auth-flow.mjs",
    "test:admin-api-integration": "node tests/admin-api-integration.mjs",
    "test:admin-session-cookie": "node tests/admin-session-cookie.mjs",
    "test:admin-full-flow": "node tests/admin-full-flow.mjs",
    "test:admin-staff-commands": "node tests/admin-staff-commands.cjs",
    "test:admin-postgres": "node tests/admin-postgres-integration.mjs",
    "test:admin-postgres-local": "node tests/run-admin-postgres.mjs",
    "test:admin-auth-sdk-http": "node tests/admin-auth-sdk-http.mjs",
    "test:admin-app-local": "node tests/admin-app-local.mjs",
    "test:admin-http-smoke": "node tests/admin-http-smoke.mjs",
    "test:admin-node-adapter": "node tests/admin-node-adapter.mjs",
    "test:admin-login-browser": "node tests/admin-login-browser.cjs",
    "test:admin-platform-rules": "node tests/platform-rules-sync.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
