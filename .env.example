# Optional for local offline use; required for connected public content.
# Copy to .env.local. Keep both commented to run offline; uncomment the pair
# only when you have the public key. For Vercel set in the intended scope.
# Only a publishable key (or a legacy anon JWT for this project) is allowed.
# VITE_SUPABASE_URL=https://jvpadtzfsuekixrquzjv.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Public Vite settings only. Do not put a DB password or Admin keys here.
# npm run dev:admin-init creates a separate private server file outside the repo.
# Run npm run dev:api and npm run dev:web in separate processes.
# Local and Vercel scope matrix: docs/MASTER_ADMIN_DEPLOYMENT.md
